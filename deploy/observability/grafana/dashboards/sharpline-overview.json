    {
      "id": 10,
      "type": "timeseries",
      "title": "Provider quota remaining",
      "description": "Left axis: requests left in the budget. The burn rate is the second series — if adaptive polling is backing off correctly it flattens as the budget drains.",
      "datasource": { "type": "prometheus", "uid": "sharpline-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {

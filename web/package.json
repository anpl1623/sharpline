{
  "name": "sharpline-web",
  "version": "0.1.0",
  "private": true,
  "description": "Sharpline frontend \u2014 Next.js 15 App Router. Runs only in a container (CLAUDE.md prime directive).",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "tar": "^7.5.22",
    "brace-expansion": "^5.0.9",
    "undici": "^6.27.0",
    "ip-address": "^10.5.0",
    "sharp": "^0.35.3"
  }
